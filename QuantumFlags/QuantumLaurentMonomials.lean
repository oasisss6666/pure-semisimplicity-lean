import QuantumFlags.QuantumLaurentSkew
import Mathlib.RingTheory.AlgebraTower
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Algebra.Algebra.Operations
import Mathlib.Algebra.Algebra.Rat

/-!
# Lemma `lem:qtorus`, assertion (2): the monomial basis

Manuscript source lines 169-173 and 192.  In `T_n` put `M_a = t_1^{a_1} ⋯ t_n^{a_n}` for
`a ∈ ℤ^n`.  The monomials multiply according to
`M_a M_b = q^{∑_{i=1}^{n-1} a_{i+1} b_i} M_{a+b}`,
they are linearly independent over `ℚ`, and they span the `ℚ`-subalgebra of `T_n` generated by
`t_1^{±1}, …, t_n^{±1}`.  Hence this subalgebra has the `ℚ`-basis `(M_a)` with the multiplication
table defining the quantum Laurent algebra `𝒜_n`.

Indices are `0`-based: `t_{i+1}` is `quantumGenerators n i` for `i : Fin n`.
-/

namespace QuantumFlags
noncomputable section

variable (q : ℚ) (hq : q ≠ 0)

/-- The generators `t_1, …, t_n` of `T_n`. -/
def quantumGenerators : (n : ℕ) → Fin n → QuantumLevel q hq n
  | 0 => Fin.elim0
  | n+1 => Fin.lastCases (quantumGenerator q hq n)
      (fun j => quantumStep q hq n (quantumGenerators n j))

theorem quantumGenerators_last (n : ℕ) :
    quantumGenerators q hq (n+1) (Fin.last n) = quantumGenerator q hq n := by
  simp only [quantumGenerators, Fin.lastCases_last]

theorem quantumGenerators_castSucc (n : ℕ) (j : Fin n) :
    quantumGenerators q hq (n+1) j.castSucc = quantumStep q hq n (quantumGenerators q hq n j) := by
  simp only [quantumGenerators, Fin.lastCases_castSucc]

/-- The monomial `M_a = t_1^{a_1} ⋯ t_n^{a_n}`, built as `M_{a'} t_n^{a_n}`. -/
def quantumMonomial : (n : ℕ) → (Fin n → ℤ) → QuantumLevel q hq n
  | 0, _ => 1
  | n+1, a => quantumStep q hq n (quantumMonomial n (Fin.init a)) *
      quantumGenerator q hq n ^ (a (Fin.last n))

theorem quantumMonomial_succ (n : ℕ) (a : Fin (n+1) → ℤ) :
    quantumMonomial q hq (n+1) a = quantumStep q hq n (quantumMonomial q hq n (Fin.init a)) *
      quantumGenerator q hq n ^ (a (Fin.last n)) := rfl

/-- `M_a` is the ordered product `t_1^{a_1} ⋯ t_n^{a_n}`. -/
theorem quantumMonomial_eq_prod (n : ℕ) (a : Fin n → ℤ) :
    quantumMonomial q hq n a = (List.ofFn fun i => quantumGenerators q hq n i ^ a i).prod := by
  induction n with
  | zero => simp [quantumMonomial]
  | succ n ih =>
    rw [quantumMonomial_succ, ih, List.ofFn_succ', List.prod_concat, map_list_prod,
      List.map_ofFn, quantumGenerators_last]
    congr 2
    congr 1
    funext i
    simp only [Function.comp_apply, map_zpow₀, quantumGenerators_castSucc]
    rfl

theorem quantumMonomial_zero (n : ℕ) : quantumMonomial q hq n 0 = 1 := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [quantumMonomial_succ]
    have h : Fin.init (0 : Fin (n+1) → ℤ) = 0 := rfl
    rw [h, ih, map_one, one_mul]
    simp

/-- The exponent `∑_{i=1}^{n-1} a_{i+1} b_i` of the multiplication rule. -/
def quantumExponent (n : ℕ) (a b : Fin n → ℤ) : ℤ :=
  ∑ i : Fin n, ∑ j : Fin n, if (j : ℕ) = (i : ℕ) + 1 then a j * b i else 0

theorem quantumExponent_zero (a b : Fin 0 → ℤ) : quantumExponent 0 a b = 0 := by
  simp [quantumExponent]

theorem quantumExponent_one (a b : Fin 1 → ℤ) : quantumExponent 1 a b = 0 := by
  simp [quantumExponent]

theorem quantumExponent_eq (n : ℕ) (a b : Fin n → ℤ) :
    quantumExponent n a b = ∑ i : Fin n, if h : (i : ℕ) + 1 < n then a ⟨i + 1, h⟩ * b i else 0 := by
  unfold quantumExponent
  refine Finset.sum_congr rfl fun i _ => ?_
  split_ifs with h
  · rw [Finset.sum_eq_single ⟨i + 1, h⟩]
    · simp
    · intro j _ hj
      rw [if_neg]
      intro hji
      exact hj (Fin.ext hji)
    · intro h'; exact absurd (Finset.mem_univ _) h'
  · apply Finset.sum_eq_zero
    intro j _
    rw [if_neg]
    intro hji
    exact h (hji ▸ j.isLt)

theorem quantumExponent_succ_succ (n : ℕ) (a b : Fin (n+2) → ℤ) :
    quantumExponent (n+2) a b = quantumExponent (n+1) (Fin.init a) (Fin.init b) +
      a (Fin.last (n+1)) * b (Fin.last n).castSucc := by
  rw [quantumExponent_eq, quantumExponent_eq, Fin.sum_univ_castSucc, Fin.sum_univ_castSucc,
    Fin.sum_univ_castSucc (n := n)]
  have h1 : ¬ ((Fin.last (n+1) : ℕ) + 1 < n + 2) := by simp
  have h2 : ¬ ((Fin.last n : ℕ) + 1 < n + 1) := by simp
  have h3 : ((Fin.last n).castSucc : ℕ) + 1 < n + 2 := by simp
  rw [dif_neg h1, dif_neg h2, dif_pos h3, add_zero, add_zero]
  congr 1
  · refine Finset.sum_congr rfl fun i _ => ?_
    have hi : ((i.castSucc.castSucc : Fin (n+2)) : ℕ) + 1 < n + 2 := by
      simp
    have hi' : ((i.castSucc : Fin (n+1)) : ℕ) + 1 < n + 1 := by simp
    rw [dif_pos hi, dif_pos hi']
    simp only [Fin.init]
    congr 2

/-- The automorphism `τ_{m+1}` scales `M_a` by `q^{a_{m+1}}`. -/
theorem quantumAutomorphism_monomial (m : ℕ) (a : Fin (m+1) → ℤ) :
    quantumAutomorphism q hq (m+1) (quantumMonomial q hq (m+1) a) =
      ((q : ℚ) : QuantumLevel q hq (m+1)) ^ (a (Fin.last m)) * quantumMonomial q hq (m+1) a := by
  rw [quantumMonomial_succ, map_mul, quantumAutomorphism_fixes, map_zpow₀,
    quantumAutomorphism_scales, (Rat.cast_commute q (quantumGenerator q hq m)).mul_zpow]
  rw [← mul_assoc, ← mul_assoc]
  congr 1
  exact ((Rat.cast_commute q _).zpow_left₀ _).eq.symm

/-- Integer powers of an automorphism scaling `x` by a nonzero rational. -/
theorem ringAut_zpow_of_scaling {K : Type*} [DivisionRing K] [CharZero K] (σ : RingAut K)
    (c : ℚ) (hc : c ≠ 0) (x : K) (hx : σ x = (c : K) * x) (k : ℤ) :
    (σ ^ k) x = (c : K) ^ k * x := by
  have hc' : (c : K) ≠ 0 := by exact_mod_cast hc
  have hinv : σ⁻¹ x = (c : K)⁻¹ * x := by
    apply σ.injective
    change σ (σ⁻¹ x) = σ ((c : K)⁻¹ * x)
    have h1 : σ (σ⁻¹ x) = x := by
      change (σ * σ⁻¹) x = x
      rw [mul_inv_cancel]; rfl
    rw [h1, map_mul, map_inv₀, map_ratCast, hx, ← mul_assoc, inv_mul_cancel₀ hc', one_mul]
  induction k using Int.induction_on with
  | zero => simp
  | succ i ih =>
    rw [zpow_add_one]
    change (σ ^ (i : ℤ)) (σ x) = _
    rw [hx, map_mul, map_ratCast, ih, zpow_add_one₀ hc', ← mul_assoc,
      ((Rat.cast_commute c _).zpow_left₀ (i : ℤ)).eq.symm]
  | pred i ih =>
    rw [zpow_sub_one]
    change (σ ^ (-(i : ℤ))) (σ⁻¹ x) = _
    rw [hinv, map_mul, map_inv₀, map_ratCast, ih, zpow_sub_one₀ hc']
    rw [← mul_assoc]
    congr 1
    exact (((Commute.refl (c : K)).inv_left₀).zpow_right₀ _).eq

/-- The automorphism `τ_{m+1}^k` scales `M_a` by `q^{a_{m+1} k}`. -/
theorem quantumAutomorphism_zpow_monomial (m : ℕ) (a : Fin (m+1) → ℤ) (k : ℤ) :
    ((quantumAutomorphism q hq (m+1) : RingAut _) ^ k) (quantumMonomial q hq (m+1) a) =
      ((q : ℚ) : QuantumLevel q hq (m+1)) ^ (a (Fin.last m) * k) * quantumMonomial q hq (m+1) a := by
  have h := ringAut_zpow_of_scaling (quantumAutomorphism q hq (m+1) : RingAut _)
    (q ^ (a (Fin.last m))) (zpow_ne_zero _ hq) (quantumMonomial q hq (m+1) a)
    (by rw [Rat.cast_zpow]; exact quantumAutomorphism_monomial q hq m a) k
  rw [h, Rat.cast_zpow, ← zpow_mul]

/-- The multiplication rule `M_a M_b = q^{∑ a_{i+1} b_i} M_{a+b}`. -/
theorem quantumMonomial_mul (n : ℕ) (a b : Fin n → ℤ) :
    quantumMonomial q hq n a * quantumMonomial q hq n b =
      ((q : ℚ) : QuantumLevel q hq n) ^ (quantumExponent n a b) *
        quantumMonomial q hq n (a + b) := by
  induction n with
  | zero => simp [quantumMonomial, quantumExponent_zero]
  | succ n ih =>
    have hv := quantumGenerator_ne_zero q hq n
    rw [quantumMonomial_succ, quantumMonomial_succ, quantumMonomial_succ]
    have hswap : quantumGenerator q hq n ^ (a (Fin.last n)) *
        quantumStep q hq n (quantumMonomial q hq n (Fin.init b)) =
        quantumStep q hq n (((quantumAutomorphism q hq n : RingAut _) ^ (a (Fin.last n)))
          (quantumMonomial q hq n (Fin.init b))) * quantumGenerator q hq n ^ (a (Fin.last n)) :=
      quantumGenerator_zpow_mul q hq n _ _
    calc quantumStep q hq n (quantumMonomial q hq n (Fin.init a)) *
          quantumGenerator q hq n ^ (a (Fin.last n)) *
          (quantumStep q hq n (quantumMonomial q hq n (Fin.init b)) *
            quantumGenerator q hq n ^ (b (Fin.last n)))
        = quantumStep q hq n (quantumMonomial q hq n (Fin.init a) *
            ((quantumAutomorphism q hq n : RingAut _) ^ (a (Fin.last n)))
              (quantumMonomial q hq n (Fin.init b))) *
            (quantumGenerator q hq n ^ (a (Fin.last n)) *
              quantumGenerator q hq n ^ (b (Fin.last n))) := by
          rw [map_mul, mul_assoc, ← mul_assoc (quantumGenerator q hq n ^ _), hswap]
          simp only [mul_assoc]
      _ = _ := by
          rw [← zpow_add₀ hv]
          cases n with
          | zero =>
            have h0 : ∀ c : Fin 0 → ℤ, quantumMonomial q hq 0 c = 1 := fun _ => rfl
            have he : quantumExponent (0+1) a b = 0 := quantumExponent_one a b
            simp only [h0, map_one, one_mul, he, zpow_zero]
            rfl
          | succ m =>
            rw [quantumAutomorphism_zpow_monomial]
            set c : QuantumLevel q hq (m+1) := ((q : ℚ) : QuantumLevel q hq (m+1)) ^
              (Fin.init b (Fin.last m) * a (Fin.last (m+1)))
            have hcomm : ∀ y : QuantumLevel q hq (m+1), y * c = c * y := fun y =>
              ((Rat.cast_commute q y).zpow_left₀ _).eq.symm
            rw [← mul_assoc, hcomm, mul_assoc, ih, ← mul_assoc]
            have hcz : c * ((q : ℚ) : QuantumLevel q hq (m+1)) ^
                quantumExponent (m+1) (Fin.init a) (Fin.init b) =
                ((q : ℚ) : QuantumLevel q hq (m+1)) ^ quantumExponent (m+2) a b := by
              rw [← zpow_add₀ (by exact_mod_cast hq), quantumExponent_succ_succ]
              congr 1
              simp only [Fin.init]
              ring
            rw [hcz, map_mul, map_zpow₀, map_ratCast, mul_assoc]
            rfl

/-- The monomials are linearly independent over `ℚ`. -/
theorem quantumMonomial_linearIndependent (n : ℕ) :
    LinearIndependent ℚ (quantumMonomial q hq n) := by
  induction n with
  | zero =>
    rw [linearIndependent_unique_iff]
    change (1 : QuantumLevel q hq 0) ≠ 0
    exact one_ne_zero
  | succ n ih =>
    letI := powerLeftCoefficientModule (quantumStep q hq n)
    haveI : IsScalarTower ℚ (QuantumLevel q hq n) (QuantumLevel q hq (n+1)) := by
      constructor
      intro r c x
      change quantumStep q hq n (r • c) * x = r • (quantumStep q hq n c * x)
      rw [Rat.smul_def, Rat.smul_def, map_mul, map_ratCast, mul_assoc]
    have h := linearIndependent_smul ih
      (quantumGenerator_integer_left_powers_independent q hq n)
    let e : (Fin (n+1) → ℤ) ≃ (Fin n → ℤ) × ℤ :=
      { toFun := fun a => (Fin.init a, a (Fin.last n))
        invFun := fun p => Fin.snoc p.1 p.2
        left_inv := fun a => Fin.snoc_init_self a
        right_inv := fun p => by simp }
    exact h.comp e e.injective

/-- The `ℚ`-subalgebra of `T_n` generated by `t_1^{±1}, …, t_n^{±1}`. -/
abbrev quantumLaurentSubalgebra (n : ℕ) : Subalgebra ℚ (QuantumLevel q hq n) :=
  Algebra.adjoin ℚ (Set.range (quantumGenerators q hq n) ∪
    Set.range fun i => (quantumGenerators q hq n i)⁻¹)

theorem quantumGenerators_eq_monomial (n : ℕ) (i : Fin n) :
    (∃ a, quantumMonomial q hq n a = quantumGenerators q hq n i) ∧
      ∃ b, quantumMonomial q hq n b = (quantumGenerators q hq n i)⁻¹ := by
  induction n with
  | zero => exact Fin.elim0 i
  | succ n ih =>
    induction i using Fin.lastCases with
    | last =>
      refine ⟨⟨Fin.snoc 0 1, ?_⟩, ⟨Fin.snoc 0 (-1), ?_⟩⟩
      · rw [quantumMonomial_succ, quantumGenerators_last]
        simp [Fin.init_snoc, quantumMonomial_zero]
      · rw [quantumMonomial_succ, quantumGenerators_last]
        simp [Fin.init_snoc, quantumMonomial_zero]
    | cast j =>
      obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := ih j
      refine ⟨⟨Fin.snoc a 0, ?_⟩, ⟨Fin.snoc b 0, ?_⟩⟩
      · rw [quantumMonomial_succ, quantumGenerators_castSucc]
        simp [Fin.init_snoc, ha]
      · rw [quantumMonomial_succ, quantumGenerators_castSucc]
        simp [Fin.init_snoc, hb, map_inv₀]

theorem quantumMonomial_mem (n : ℕ) (a : Fin n → ℤ) :
    quantumMonomial q hq n a ∈ quantumLaurentSubalgebra q hq n := by
  rw [quantumMonomial_eq_prod]
  apply Subalgebra.list_prod_mem
  intro x hx
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hx
  have hg : quantumGenerators q hq n i ∈ quantumLaurentSubalgebra q hq n :=
    Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩)
  have hgi : (quantumGenerators q hq n i)⁻¹ ∈ quantumLaurentSubalgebra q hq n :=
    Algebra.subset_adjoin (Or.inr ⟨i, rfl⟩)
  rcases Int.eq_nat_or_neg (a i) with ⟨k, hk | hk⟩
  · rw [hk, zpow_natCast]; exact Subalgebra.pow_mem _ hg k
  · rw [hk, zpow_neg, zpow_natCast, ← inv_pow]; exact Subalgebra.pow_mem _ hgi k

/-- The span of the monomials is closed under multiplication. -/
theorem quantumMonomial_span_mul_mem (n : ℕ) {x y : QuantumLevel q hq n}
    (hx : x ∈ Submodule.span ℚ (Set.range (quantumMonomial q hq n)))
    (hy : y ∈ Submodule.span ℚ (Set.range (quantumMonomial q hq n))) :
    x * y ∈ Submodule.span ℚ (Set.range (quantumMonomial q hq n)) := by
  have hmul := Submodule.mul_mem_mul hx hy
  rw [Submodule.span_mul_span] at hmul
  refine Submodule.span_le.mpr ?_ hmul
  rintro _ ⟨_, ⟨a, rfl⟩, _, ⟨b, rfl⟩, rfl⟩
  show quantumMonomial q hq n a * quantumMonomial q hq n b ∈ _
  rw [quantumMonomial_mul, ← Rat.cast_zpow, ← Rat.smul_def]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a + b, rfl⟩)

/-- The generated subalgebra is the span of the monomials. -/
theorem quantumLaurentSubalgebra_eq_span (n : ℕ) :
    Subalgebra.toSubmodule (quantumLaurentSubalgebra q hq n) =
      Submodule.span ℚ (Set.range (quantumMonomial q hq n)) := by
  apply le_antisymm
  · let P := (Submodule.span ℚ (Set.range (quantumMonomial q hq n))).toSubalgebra
      (Submodule.subset_span ⟨0, quantumMonomial_zero q hq n⟩)
      (fun x y hx hy => quantumMonomial_span_mul_mem q hq n hx hy)
    have hle : quantumLaurentSubalgebra q hq n ≤ P := by
      apply Algebra.adjoin_le
      rintro _ (⟨i, rfl⟩ | ⟨i, rfl⟩)
      · obtain ⟨⟨a, ha⟩, _⟩ := quantumGenerators_eq_monomial q hq n i
        exact Submodule.subset_span ⟨a, ha⟩
      · obtain ⟨_, ⟨b, hb⟩⟩ := quantumGenerators_eq_monomial q hq n i
        exact Submodule.subset_span ⟨b, hb⟩
    intro x hx
    exact hle hx
  · rw [Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    exact quantumMonomial_mem q hq n a

/-- The monomial basis of the generated subalgebra. -/
def quantumLaurentBasis (n : ℕ) :
    Module.Basis (Fin n → ℤ) ℚ (quantumLaurentSubalgebra q hq n) :=
  ((Module.Basis.span (quantumMonomial_linearIndependent q hq n)).map
    (LinearEquiv.ofEq _ _ (quantumLaurentSubalgebra_eq_span q hq n).symm)).map
      (Subalgebra.toSubmoduleEquiv _)

theorem quantumLaurentBasis_apply (n : ℕ) (a : Fin n → ℤ) :
    (quantumLaurentBasis q hq n a : QuantumLevel q hq n) = quantumMonomial q hq n a := by
  simp [quantumLaurentBasis, Module.Basis.span_apply]
  rfl

/-- Manuscript `lem:qtorus` (2), first assertion: the `ℚ`-subalgebra of `T_n` generated by
`t_1^{±1}, …, t_n^{±1}` has the `ℚ`-basis `M_a = t_1^{a_1} ⋯ t_n^{a_n}` (`a ∈ ℤ^n`) with the
multiplication `M_a M_b = q^{∑_{i=1}^{n-1} a_{i+1} b_i} M_{a+b}`, i.e. it is the quantum Laurent
algebra `𝒜_n`. -/
theorem quantumLaurentSubalgebra_is_quantumTorus (n : ℕ) :
    ∃ b : Module.Basis (Fin n → ℤ) ℚ (quantumLaurentSubalgebra q hq n),
      (∀ a, (b a : QuantumLevel q hq n) =
        (List.ofFn fun i => quantumGenerators q hq n i ^ a i).prod) ∧
      ∀ a c, b a * b c = (q ^ quantumExponent n a c) • b (a + c) := by
  refine ⟨quantumLaurentBasis q hq n, fun a => ?_, fun a c => ?_⟩
  · rw [quantumLaurentBasis_apply, quantumMonomial_eq_prod]
  · apply Subtype.ext
    rw [Subalgebra.coe_mul, Subalgebra.coe_smul, quantumLaurentBasis_apply,
      quantumLaurentBasis_apply, quantumLaurentBasis_apply, quantumMonomial_mul, Rat.smul_def,
      Rat.cast_zpow]

end
end QuantumFlags
