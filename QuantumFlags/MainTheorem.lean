import QuantumFlags.QuantumLaurentFractions
import QuantumFlags.ActualPureSemisimplicity
import QuantumFlags.LeftPureSemisimplicityFailure
import QuantumFlags.ActualDimensionSequence

/-!
# The main theorem

Manuscript `thm:main` (source lines 55-61) and its proof (source lines 414-422).

* `T = OreUnion` is the increasing union of the division rings `T_n = OreLevel n`, and `T_n` is
  the division ring of fractions of the nearest-neighbour quantum Laurent algebra `𝒜_n` over `ℚ`
  with `t_{i+1} t_i = (1/2) t_i t_{i+1}` (`lem:qtorus` with `q = 1/2`).
* `t = t_1`, and `H_r = κ_r(T)` with `κ_r(x) = Γ_{n,r} x Γ_{n,r}^{-1}` for `x ∈ T_n`,
  `Γ_{n,r} = (1 - t_1) P_r(t_2) ⋯ P_r(t_{n+1})`, and `H_0 = T`.
* Conditions (B) and (F) hold, `ₕT_T` has right dimension sequence `(1,2,2,2,...)`,
  `dim ₕT = ∞`, and `R = (H T; 0 T)` is right pure semisimple but neither left pure semisimple
  nor of finite representation type.  In particular the pure semisimplicity conjecture fails.

Right modules over `R` are modules over `Rᵐᵒᵖ`; pure semisimplicity and representation type are
stated for modules in an arbitrary universe `w`.  The left half is proved without the theorem of
Chase, see `QuantumFlags.LeftPureSemisimplicityFailure`.
-/

namespace QuantumFlags
noncomputable section
open scoped nonZeroDivisors
universe w

/-- The parameter `q = 1/2` of the counterexample is nonzero. -/
theorem quantumHalf_ne_zero : (1/2 : ℚ) ≠ 0 := by norm_num

theorem oreLevel_eq_quantumLevel (n : ℕ) : OreLevel n = QuantumLevel (1/2) quantumHalf_ne_zero n := rfl

/-- `t = t_1`. -/
theorem actual_t_eq_first_generator :
    actualFlagSystem.t = oreEmbed 1 (quantumGenerators (1/2) quantumHalf_ne_zero 1 0) := rfl

/-- Manuscript `thm:main`. -/
theorem main_theorem :
    -- `T` is the increasing union of the `T_n`
    (Monotone oreLayer ∧ ∀ a : OreUnion, ∃ n, a ∈ oreLayer n) ∧
    -- the `ℚ`-subalgebra of `T_n = OreLevel n = QuantumLevel (1/2) _ n` generated by
    -- `t_1^{±1}, …, t_n^{±1}` is the quantum Laurent algebra `𝒜_n` with `q = 1/2`: it has the
    -- monomial basis `M_a = t_1^{a_1} ⋯ t_n^{a_n}` with `M_a M_b = (1/2)^{∑ a_{i+1} b_i} M_{a+b}`;
    -- and `T_n` is its division ring of fractions
    (∀ n,
      (∃ b : Module.Basis (Fin n → ℤ) ℚ (quantumLaurentSubalgebra (1/2) quantumHalf_ne_zero n),
        (∀ a, (b a : QuantumLevel (1/2) quantumHalf_ne_zero n) =
          (List.ofFn fun i => quantumGenerators (1/2) quantumHalf_ne_zero n i ^ a i).prod) ∧
        ∀ a c, b a * b c = ((1/2 : ℚ) ^ quantumExponent n a c) • b (a + c)) ∧
      ∃ e : OreLocalization (quantumLaurentSubalgebra (1/2) quantumHalf_ne_zero n)⁰
        (quantumLaurentSubalgebra (1/2) quantumHalf_ne_zero n) ≃+* QuantumLevel (1/2) quantumHalf_ne_zero n,
      ∀ a, e (OreLocalization.numeratorRingHom a) = a) ∧
    -- `t = t_1`
    actualFlagSystem.t = oreEmbed 1 (quantumGenerators (1/2) quantumHalf_ne_zero 1 0) ∧
    -- `H_r = κ_r(T)` with `κ_r` given on `T_n` by conjugation with `Γ_{n,r}`, and `H_0 = T`
    (∀ r, actualFlagSystem.H r = (kappa actualQuantumChain r).fieldRange) ∧
    (∀ r n (a : OreUnion), a ∈ oreLayer n →
      kappa actualQuantumChain r a = gamma oreVariable r n * a * (gamma oreVariable r n)⁻¹) ∧
    actualFlagSystem.H 0 = ⊤ ∧
    -- condition (B)
    (∀ r, 1 ≤ r → Function.Bijective (wideEval (actualFlagSystem.H r).subtype
      (fun i : Fin (r+1) => actualFlagSystem.t ^ i.val))) ∧
    -- condition (F)
    (∀ p, 1 ≤ p →
      Function.Injective (leftEval (actualFlagSystem.H p).subtype actualFlagSystem.t) ∧
      Function.Injective (rightEval (actualFlagSystem.H (p+1)).subtype actualFlagSystem.t) ∧
      Set.range (leftEval (actualFlagSystem.H p).subtype actualFlagSystem.t) =
        Set.range (rightEval (actualFlagSystem.H (p+1)).subtype actualFlagSystem.t)) ∧
    -- right dimension sequence `(1,2,2,2,...)`
    (∀ n, FiniteDimensional
        (iteratedRightDual (ambientBimodule (actualFlagSystem.H 1)) n).RightRingᵐᵒᵖ
        (iteratedRightDual (ambientBimodule (actualFlagSystem.H 1)) n).Space ∧
      Module.finrank (iteratedRightDual (ambientBimodule (actualFlagSystem.H 1)) n).RightRingᵐᵒᵖ
        (iteratedRightDual (ambientBimodule (actualFlagSystem.H 1)) n).Space =
          if n = 0 then 1 else 2) ∧
    -- `dim ₕT = ∞`
    ¬ FiniteDimensional (actualFlagSystem.H 1) OreUnion ∧
    -- `R` is right pure semisimple, not left pure semisimple, not of finite representation type
    IsRightPureSemisimple.{0,w} ActualTriangularRing ∧
    ¬ IsLeftPureSemisimple.{0,w} ActualTriangularRing ∧
    ¬ IsFiniteRepresentationType.{0,w} ActualTriangularRing := by
  refine ⟨⟨oreLayer_increasing, oreLayer_covers⟩, fun n => ⟨quantumLaurentSubalgebra_is_quantumTorus _ _ n,
    quantumLaurent_fraction_field _ _ n⟩,
    rfl, fun r => rfl, fun r n a ha => kappa_at actualQuantumChain r n a ha,
    imageField_zero actualQuantumChain actualPowerChainProperties,
    fun r _ => actual_global_right_basis r,
    fun p hp => actual_global_adjacent_flags p hp,
    fun n => ⟨iterated_right_dual_finite actualFlagSystem n, actual_right_dimension_sequence n⟩,
    left_dimension_infinite actualFlagSystem 1 le_rfl,
    actual_triangular_right_pure_semisimple, actual_triangular_not_left_pure_semisimple,
    actual_triangular_not_finite_representation_type⟩

/-- In particular, the pure semisimplicity conjecture fails: there is a right pure semisimple
ring that is not of finite representation type. -/
theorem pure_semisimplicity_conjecture_fails :
    ∃ (R : Type) (_ : Ring R), IsRightPureSemisimple.{0,w} R ∧ ¬ IsFiniteRepresentationType.{0,w} R :=
  ⟨ActualTriangularRing, inferInstance, actual_triangular_right_pure_semisimple,
    actual_triangular_not_finite_representation_type⟩

end
end QuantumFlags
