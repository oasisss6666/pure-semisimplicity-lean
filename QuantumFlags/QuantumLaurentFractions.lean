import QuantumFlags.QuantumLaurentMonomials
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.Algebra.Order.Ring.Pow
import Mathlib.Data.Int.Interval
import Mathlib.Algebra.Algebra.Hom.Rat
import Mathlib.Algebra.Field.Subfield.Basic
import Mathlib.Algebra.Order.Field.Basic

/-!
# Lemma `lem:qtorus`, assertion (2): Ore condition and division ring of fractions

Manuscript source line 192.  The quantum Laurent algebra `𝒜_n ⊆ T_n` is a two-sided Ore domain:
for nonzero `u, w` and monomial supports in boxes `{0, …, L}^n`, the `ℚ`-linear map
`(X, Y) ↦ uX - wY` has more unknowns, `2 (L+1)^n`, than the dimension `(L+W+1)^n` of the space
containing its image once `L` is large, so it has a nonzero kernel element, and both `X` and `Y`
are nonzero because `𝒜_n` is a domain.  The division subring of `T_n` generated by `𝒜_n` contains
`T_{n-1}` by induction and `t_n`, hence is `T_n`.  Consequently the canonical map from the Ore
localization of `𝒜_n` to `T_n` is an isomorphism: `T_n` is the division ring of fractions of
`𝒜_n`.  Finally the inclusions `𝒜_n ⊆ 𝒜_{n+1}` extend `T_n ⊆ T_{n+1}`.
-/

namespace QuantumFlags
noncomputable section
open scoped nonZeroDivisors
open OreLocalization

variable (q : ℚ) (hq : q ≠ 0)

/-- The box `{0, …, L}^n` of exponents. -/
def exponentBox (n L : ℕ) : Finset (Fin n → ℤ) := Fintype.piFinset fun _ => Finset.Icc (0 : ℤ) L

theorem card_exponentBox (n L : ℕ) : (exponentBox n L).card = (L+1)^n := by
  simp [exponentBox, Int.card_Icc]

theorem mem_exponentBox {n L : ℕ} {a : Fin n → ℤ} :
    a ∈ exponentBox n L ↔ ∀ i, 0 ≤ a i ∧ a i ≤ L := by
  simp [exponentBox]

/-- A translate `c + {0, …, L}^n` of the box. -/
def shiftedBox (n L : ℕ) (c : Fin n → ℤ) : Finset (Fin n → ℤ) :=
  (exponentBox n L).image (· + c)

theorem card_shiftedBox (n L : ℕ) (c : Fin n → ℤ) : (shiftedBox n L c).card = (L+1)^n := by
  rw [shiftedBox, Finset.card_image_of_injective _ (add_left_injective c), card_exponentBox]

/-- Every finite set of exponents lies in some translate of a box. -/
theorem exists_shiftedBox (n : ℕ) (F : Finset (Fin n → ℤ)) :
    ∃ (c : Fin n → ℤ) (W : ℕ), F ⊆ shiftedBox n W c := by
  let B : ℕ := F.sup fun a => Finset.univ.sup fun i => (a i).natAbs
  refine ⟨fun _ => -(B : ℤ), 2 * B, fun a ha => ?_⟩
  have hb : ∀ i, (a i).natAbs ≤ B := fun i =>
    (Finset.le_sup (f := fun i => (a i).natAbs) (Finset.mem_univ i)).trans
      (Finset.le_sup (f := fun a : Fin n → ℤ => Finset.univ.sup fun i => (a i).natAbs) ha)
  refine Finset.mem_image.mpr ⟨fun i => a i + B, ?_, ?_⟩
  · rw [mem_exponentBox]
    intro i
    have := hb i
    constructor <;> omega
  · funext i; simp

/-- Translates of boxes add up. -/
theorem shiftedBox_add {n L W : ℕ} {c a b : Fin n → ℤ} (ha : a ∈ shiftedBox n W c)
    (hb : b ∈ exponentBox n L) : a + b ∈ shiftedBox n (W + L) c := by
  obtain ⟨a', ha', rfl⟩ := Finset.mem_image.mp ha
  refine Finset.mem_image.mpr ⟨a' + b, ?_, by funext i; simp; ring⟩
  rw [mem_exponentBox] at ha' hb ⊢
  intro i
  have h1 := ha' i
  have h2 := hb i
  simp only [Pi.add_apply, Nat.cast_add]
  constructor <;> omega

/-- The counting inequality `(L+W+1)^n < 2 (L+1)^n` for some `L`. -/
theorem exists_box_count (n W : ℕ) : ∃ L : ℕ, (L + W + 1)^n < 2 * (L+1)^n := by
  refine ⟨2 * n * W, ?_⟩
  have key : ((2 * n * W + W + 1 : ℕ) : ℚ)^n < 2 * ((2 * n * W + 1 : ℕ) : ℚ)^n := by
    have hW : (0 : ℚ) ≤ W := by positivity
    have hn : (0 : ℚ) ≤ n := by positivity
    rw [show ((2 * n * W + W + 1 : ℕ) : ℚ) = 2 * n * W + W + 1 by push_cast; ring,
      show ((2 * n * W + 1 : ℕ) : ℚ) = 2 * n * W + 1 by push_cast; ring]
    have hB : (0 : ℚ) < 2 * n * W + W + 1 := by positivity
    have hxB : (W : ℚ) / (2 * n * W + W + 1) ≤ 1 := by
      rw [div_le_one hB]; nlinarith
    have hbern := one_add_mul_le_pow (a := -((W : ℚ) / (2 * n * W + W + 1))) (by linarith) n
    have hnx : (n : ℚ) * ((W : ℚ) / (2 * n * W + W + 1)) < 1/2 := by
      rw [mul_div_assoc', div_lt_iff₀ hB]
      nlinarith
    have h1 : (1 : ℚ) + -((W : ℚ) / (2 * n * W + W + 1)) =
        (2 * n * W + 1) / (2 * n * W + W + 1) := by
      field_simp
      ring
    have hpow : (1/2 : ℚ) < ((2 * n * W + 1) / (2 * n * W + W + 1))^n := by
      rw [← h1]
      calc (1/2 : ℚ) < 1 + n * -((W : ℚ) / (2 * n * W + W + 1)) := by linarith
        _ ≤ _ := hbern
    rw [div_pow, lt_div_iff₀ (by positivity)] at hpow
    linarith
  have hcast : (2 * n * W + W + 1)^n < 2 * (2 * n * W + 1)^n := by exact_mod_cast key
  simpa [add_assoc] using hcast

/-- The span of the monomials with exponents in a finite set. -/
abbrev monomialSpan (n : ℕ) (F : Finset (Fin n → ℤ)) : Submodule ℚ (QuantumLevel q hq n) :=
  Submodule.span ℚ (quantumMonomial q hq n '' (F : Set (Fin n → ℤ)))

theorem monomialSpan_finrank (n : ℕ) (F : Finset (Fin n → ℤ)) :
    Module.finrank ℚ (monomialSpan q hq n F) = F.card := by
  have hli : LinearIndependent ℚ (fun a : F => quantumMonomial q hq n a) :=
    (quantumMonomial_linearIndependent q hq n).comp _ Subtype.val_injective
  have h := finrank_span_eq_card hli
  rw [Fintype.card_coe] at h
  rw [monomialSpan, Set.image_eq_range]
  exact h

instance monomialSpan_finiteDimensional (n : ℕ) (F : Finset (Fin n → ℤ)) :
    FiniteDimensional ℚ (monomialSpan q hq n F) :=
  FiniteDimensional.span_of_finite ℚ (F.finite_toSet.image _)

theorem monomialSpan_le (n : ℕ) (F : Finset (Fin n → ℤ)) :
    monomialSpan q hq n F ≤ Subalgebra.toSubmodule (quantumLaurentSubalgebra q hq n) := by
  rw [quantumLaurentSubalgebra_eq_span]
  exact Submodule.span_mono (Set.image_subset_range _ _)

/-- Products of monomial spans lie in the monomial span of the sum set. -/
theorem monomialSpan_mul_mem (n : ℕ) {F G H : Finset (Fin n → ℤ)}
    (hFG : ∀ a ∈ F, ∀ b ∈ G, a + b ∈ H) {x y : QuantumLevel q hq n}
    (hx : x ∈ monomialSpan q hq n F) (hy : y ∈ monomialSpan q hq n G) :
    x * y ∈ monomialSpan q hq n H := by
  have hmul := Submodule.mul_mem_mul hx hy
  rw [Submodule.span_mul_span] at hmul
  refine Submodule.span_le.mpr ?_ hmul
  rintro _ ⟨_, ⟨a, ha, rfl⟩, _, ⟨b, hb, rfl⟩, rfl⟩
  show quantumMonomial q hq n a * quantumMonomial q hq n b ∈ _
  rw [quantumMonomial_mul, ← Rat.cast_zpow, ← Rat.smul_def]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a + b, hFG a ha b hb, rfl⟩)

/-- Every element of `𝒜_n` lies in the monomial span of a translated box. -/
theorem exists_monomialSpan_of_mem (n : ℕ) {u w : QuantumLevel q hq n}
    (hu : u ∈ quantumLaurentSubalgebra q hq n) (hw : w ∈ quantumLaurentSubalgebra q hq n) :
    ∃ (c : Fin n → ℤ) (W : ℕ), u ∈ monomialSpan q hq n (shiftedBox n W c) ∧
      w ∈ monomialSpan q hq n (shiftedBox n W c) := by
  classical
  have hu' : u ∈ Submodule.span ℚ (Set.range (quantumMonomial q hq n)) := by
    rw [← quantumLaurentSubalgebra_eq_span]; exact hu
  have hw' : w ∈ Submodule.span ℚ (Set.range (quantumMonomial q hq n)) := by
    rw [← quantumLaurentSubalgebra_eq_span]; exact hw
  obtain ⟨Fu, hFu, huF⟩ := Submodule.mem_span_finite_of_mem_span hu'
  obtain ⟨Fw, hFw, hwF⟩ := Submodule.mem_span_finite_of_mem_span hw'
  have hpre : ∀ s : Finset (QuantumLevel q hq n), (s : Set _) ⊆ Set.range (quantumMonomial q hq n) →
      ∃ E : Finset (Fin n → ℤ), (s : Set _) ⊆ quantumMonomial q hq n '' (E : Set _) := by
    intro s hs
    choose f hf using fun x : s => hs x.property
    refine ⟨Finset.univ.image f, fun x hx => ⟨f ⟨x, hx⟩, by simp, hf ⟨x, hx⟩⟩⟩
  obtain ⟨Eu, hEu⟩ := hpre Fu hFu
  obtain ⟨Ew, hEw⟩ := hpre Fw hFw
  obtain ⟨c, W, hcW⟩ := exists_shiftedBox n (Eu ∪ Ew)
  refine ⟨c, W, ?_, ?_⟩
  · refine Submodule.span_mono ?_ huF
    refine hEu.trans (Set.image_mono ?_)
    intro a ha; exact hcW (Finset.mem_union_left _ ha)
  · refine Submodule.span_mono ?_ hwF
    refine hEw.trans (Set.image_mono ?_)
    intro a ha; exact hcW (Finset.mem_union_right _ ha)

/-- Right Ore condition in `𝒜_n`: `u 𝒜_n ∩ w 𝒜_n ≠ 0`. -/
theorem quantumLaurent_ore_right (n : ℕ) {u w : QuantumLevel q hq n}
    (hu : u ∈ quantumLaurentSubalgebra q hq n) (hw : w ∈ quantumLaurentSubalgebra q hq n)
    (hu0 : u ≠ 0) (hw0 : w ≠ 0) :
    ∃ X Y, X ∈ quantumLaurentSubalgebra q hq n ∧ Y ∈ quantumLaurentSubalgebra q hq n ∧
      X ≠ 0 ∧ Y ≠ 0 ∧ u * X = w * Y := by
  obtain ⟨c, W, huS, hwS⟩ := exists_monomialSpan_of_mem q hq n hu hw
  obtain ⟨L, hL⟩ := exists_box_count n W
  let V := monomialSpan q hq n (exponentBox n L)
  let G := monomialSpan q hq n (shiftedBox n (W + L) c)
  let Ψ : (V × V) →ₗ[ℚ] QuantumLevel q hq n :=
    (LinearMap.mulLeft ℚ u ∘ₗ V.subtype ∘ₗ LinearMap.fst ℚ V V) -
      (LinearMap.mulLeft ℚ w ∘ₗ V.subtype ∘ₗ LinearMap.snd ℚ V V)
  have hΨ : ∀ p, Ψ p ∈ G := by
    intro p
    have hadd : ∀ a ∈ shiftedBox n W c, ∀ b ∈ exponentBox n L, a + b ∈ shiftedBox n (W + L) c :=
      fun a ha b hb => shiftedBox_add ha hb
    exact G.sub_mem (monomialSpan_mul_mem q hq n hadd huS p.1.2)
      (monomialSpan_mul_mem q hq n hadd hwS p.2.2)
  let Φ : (V × V) →ₗ[ℚ] G := Ψ.codRestrict G hΨ
  have hdim : Module.finrank ℚ G < Module.finrank ℚ (V × V) := by
    rw [Module.finrank_prod, monomialSpan_finrank, monomialSpan_finrank, card_shiftedBox,
      card_exponentBox, show W + L + 1 = L + W + 1 by ring]
    linarith
  obtain ⟨p, hp, hp0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (LinearMap.ker_ne_bot_of_finrank_lt hdim)
  have heq : u * (p.1 : QuantumLevel q hq n) = w * (p.2 : QuantumLevel q hq n) := by
    have h : (Φ p : QuantumLevel q hq n) = 0 := by rw [LinearMap.mem_ker.mp hp]; rfl
    change u * (p.1 : QuantumLevel q hq n) - w * (p.2 : QuantumLevel q hq n) = 0 at h
    exact sub_eq_zero.mp h
  have hX : (p.1 : QuantumLevel q hq n) ≠ 0 := by
    intro hX
    apply hp0
    rw [hX, mul_zero] at heq
    have hY : (p.2 : QuantumLevel q hq n) = 0 := (mul_eq_zero.mp heq.symm).resolve_left hw0
    exact Prod.ext (Subtype.ext hX) (Subtype.ext hY)
  have hY : (p.2 : QuantumLevel q hq n) ≠ 0 := by
    intro hY
    apply hX
    rw [hY, mul_zero] at heq
    exact (mul_eq_zero.mp heq).resolve_left hu0
  exact ⟨p.1, p.2, monomialSpan_le q hq n _ p.1.2, monomialSpan_le q hq n _ p.2.2, hX, hY, heq⟩

/-- Left Ore condition in `𝒜_n`: `𝒜_n u ∩ 𝒜_n w ≠ 0`. -/
theorem quantumLaurent_ore_left (n : ℕ) {u w : QuantumLevel q hq n}
    (hu : u ∈ quantumLaurentSubalgebra q hq n) (hw : w ∈ quantumLaurentSubalgebra q hq n)
    (hu0 : u ≠ 0) (hw0 : w ≠ 0) :
    ∃ X Y, X ∈ quantumLaurentSubalgebra q hq n ∧ Y ∈ quantumLaurentSubalgebra q hq n ∧
      X ≠ 0 ∧ Y ≠ 0 ∧ X * u = Y * w := by
  obtain ⟨c, W, huS, hwS⟩ := exists_monomialSpan_of_mem q hq n hu hw
  obtain ⟨L, hL⟩ := exists_box_count n W
  let V := monomialSpan q hq n (exponentBox n L)
  let G := monomialSpan q hq n (shiftedBox n (W + L) c)
  let Ψ : (V × V) →ₗ[ℚ] QuantumLevel q hq n :=
    (LinearMap.mulRight ℚ u ∘ₗ V.subtype ∘ₗ LinearMap.fst ℚ V V) -
      (LinearMap.mulRight ℚ w ∘ₗ V.subtype ∘ₗ LinearMap.snd ℚ V V)
  have hΨ : ∀ p, Ψ p ∈ G := by
    intro p
    have hadd : ∀ b ∈ exponentBox n L, ∀ a ∈ shiftedBox n W c, b + a ∈ shiftedBox n (W + L) c :=
      fun b hb a ha => by rw [add_comm b a]; exact shiftedBox_add ha hb
    exact G.sub_mem (monomialSpan_mul_mem q hq n hadd p.1.2 huS)
      (monomialSpan_mul_mem q hq n hadd p.2.2 hwS)
  let Φ : (V × V) →ₗ[ℚ] G := Ψ.codRestrict G hΨ
  have hdim : Module.finrank ℚ G < Module.finrank ℚ (V × V) := by
    rw [Module.finrank_prod, monomialSpan_finrank, monomialSpan_finrank, card_shiftedBox,
      card_exponentBox, show W + L + 1 = L + W + 1 by ring]
    linarith
  obtain ⟨p, hp, hp0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (LinearMap.ker_ne_bot_of_finrank_lt hdim)
  have heq : (p.1 : QuantumLevel q hq n) * u = (p.2 : QuantumLevel q hq n) * w := by
    have h : (Φ p : QuantumLevel q hq n) = 0 := by rw [LinearMap.mem_ker.mp hp]; rfl
    change (p.1 : QuantumLevel q hq n) * u - (p.2 : QuantumLevel q hq n) * w = 0 at h
    exact sub_eq_zero.mp h
  have hX : (p.1 : QuantumLevel q hq n) ≠ 0 := by
    intro hX
    apply hp0
    rw [hX, zero_mul] at heq
    have hY : (p.2 : QuantumLevel q hq n) = 0 := (mul_eq_zero.mp heq.symm).resolve_right hw0
    exact Prod.ext (Subtype.ext hX) (Subtype.ext hY)
  have hY : (p.2 : QuantumLevel q hq n) ≠ 0 := by
    intro hY
    apply hX
    rw [hY, zero_mul] at heq
    exact (mul_eq_zero.mp heq).resolve_right hu0
  exact ⟨p.1, p.2, monomialSpan_le q hq n _ p.1.2, monomialSpan_le q hq n _ p.2.2, hX, hY, heq⟩

/-- Manuscript `lem:qtorus` (2): `𝒜_n` is a two-sided Ore domain. -/
theorem quantumLaurent_two_sided_ore_domain (n : ℕ) :
    NoZeroDivisors (quantumLaurentSubalgebra q hq n) ∧
    (∀ u w : quantumLaurentSubalgebra q hq n, u ≠ 0 → w ≠ 0 →
      ∃ X Y : quantumLaurentSubalgebra q hq n, X ≠ 0 ∧ Y ≠ 0 ∧ u * X = w * Y) ∧
    (∀ u w : quantumLaurentSubalgebra q hq n, u ≠ 0 → w ≠ 0 →
      ∃ X Y : quantumLaurentSubalgebra q hq n, X ≠ 0 ∧ Y ≠ 0 ∧ X * u = Y * w) := by
  refine ⟨inferInstance, fun u w hu hw => ?_, fun u w hu hw => ?_⟩
  · obtain ⟨X, Y, hX, hY, hX0, hY0, h⟩ := quantumLaurent_ore_right q hq n u.2 w.2
      (fun h => hu (Subtype.ext h)) (fun h => hw (Subtype.ext h))
    exact ⟨⟨X, hX⟩, ⟨Y, hY⟩, fun h' => hX0 (congrArg Subtype.val h'),
      fun h' => hY0 (congrArg Subtype.val h'), Subtype.ext h⟩
  · obtain ⟨X, Y, hX, hY, hX0, hY0, h⟩ := quantumLaurent_ore_left q hq n u.2 w.2
      (fun h => hu (Subtype.ext h)) (fun h => hw (Subtype.ext h))
    exact ⟨⟨X, hX⟩, ⟨Y, hY⟩, fun h' => hX0 (congrArg Subtype.val h'),
      fun h' => hY0 (congrArg Subtype.val h'), Subtype.ext h⟩

instance quantumLaurent_oreSet (n : ℕ) : OreSet (quantumLaurentSubalgebra q hq n)⁰ :=
  Classical.choice (nonempty_oreSet_iff_of_noZeroDivisors.mpr (by
    intro r s
    by_cases hr : r = 0
    · exact ⟨0, 1, by simp [hr]⟩
    · obtain ⟨X, Y, hX, hY, h⟩ := (quantumLaurent_two_sided_ore_domain q hq n).2.2 r s hr
        (nonZeroDivisors.coe_ne_zero s)
      exact ⟨Y, ⟨X, mem_nonZeroDivisors_of_ne_zero hX⟩, h⟩))

/-- A division subring of `T(v; τ)` containing `T` and `v` is everything. -/
theorem skewExtension_subfield_eq_top {K : Type*} [DivisionRing K] (τ : K ≃+* K)
    (F : Subfield (SkewExtension K τ)) (hK : ∀ a, extensionConstants τ a ∈ F)
    (hv : extensionVariable τ ∈ F) : F = ⊤ := by
  letI := automorphismAction τ
  have hnum : ∀ p : SkewPolynomial K, skewNumerator p ∈ F := by
    intro p
    induction p using SkewMonoidAlgebra.induction_on with
    | zero => rw [map_zero]; exact F.zero_mem
    | single n a =>
      change skewNumerator (SkewPolynomial.monomial n.toAdd a) ∈ F
      rw [← SkewPolynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
      exact F.mul_mem (hK a) (F.pow_mem hv _)
    | add p r hp hr => rw [map_add]; exact F.add_mem hp hr
  apply top_unique
  intro x _
  induction x using OreLocalization.ind with
  | c r s =>
    have h : skewNumerator (s : SkewPolynomial K) * (r /ₒ s) = skewNumerator r := by
      change ((s : SkewPolynomial K) /ₒ (1 : (SkewPolynomial K)⁰)) * (r /ₒ s) =
        r /ₒ (1 : (SkewPolynomial K)⁰)
      exact OreLocalization.mul_cancel
    have hs : skewNumerator (s : SkewPolynomial K) ≠ 0 := by
      intro h0
      exact nonZeroDivisors.coe_ne_zero s (skewNumerator_injective (h0.trans (map_zero _).symm))
    have hx : (r /ₒ s : SkewFractions K) =
        (skewNumerator (s : SkewPolynomial K))⁻¹ * skewNumerator r := by
      rw [← h, ← mul_assoc, inv_mul_cancel₀ hs, one_mul]
    rw [hx]
    exact F.mul_mem (F.inv_mem (hnum _)) (hnum r)

/-- The inclusion `T_n ⊆ T_{n+1}` maps `𝒜_n` into `𝒜_{n+1}`. -/
theorem quantumStep_mem_laurent (n : ℕ) {x : QuantumLevel q hq n}
    (hx : x ∈ quantumLaurentSubalgebra q hq n) :
    quantumStep q hq n x ∈ quantumLaurentSubalgebra q hq (n+1) := by
  let φ := (quantumStep q hq n).toRatAlgHom
  have hle : quantumLaurentSubalgebra q hq n ≤ (quantumLaurentSubalgebra q hq (n+1)).comap φ := by
    apply Algebra.adjoin_le
    rintro _ (⟨i, rfl⟩ | ⟨i, rfl⟩)
    · show φ (quantumGenerators q hq n i) ∈ quantumLaurentSubalgebra q hq (n+1)
      change quantumStep q hq n (quantumGenerators q hq n i) ∈ quantumLaurentSubalgebra q hq (n+1)
      rw [← quantumGenerators_castSucc]
      exact Algebra.subset_adjoin (Or.inl ⟨_, rfl⟩)
    · show φ (quantumGenerators q hq n i)⁻¹ ∈ quantumLaurentSubalgebra q hq (n+1)
      change quantumStep q hq n (quantumGenerators q hq n i)⁻¹ ∈ quantumLaurentSubalgebra q hq (n+1)
      rw [map_inv₀, ← quantumGenerators_castSucc]
      exact Algebra.subset_adjoin (Or.inr ⟨_, rfl⟩)
  exact hle hx

/-- The division subring of `T_n` generated by `𝒜_n` is `T_n`. -/
theorem quantumLaurent_closure (n : ℕ) :
    Subfield.closure (quantumLaurentSubalgebra q hq n : Set (QuantumLevel q hq n)) = ⊤ := by
  induction n with
  | zero =>
    apply top_unique
    intro x _
    have : x = ((x : ℚ) : QuantumLevel q hq 0) := (Rat.cast_id x).symm
    rw [this]
    exact SubfieldClass.ratCast_mem _ _
  | succ n ih =>
    let F := Subfield.closure (quantumLaurentSubalgebra q hq (n+1) : Set (QuantumLevel q hq (n+1)))
    have hstep : ∀ a, quantumStep q hq n a ∈ F := by
      have hle : Subfield.closure (quantumLaurentSubalgebra q hq n : Set (QuantumLevel q hq n)) ≤
          F.comap (quantumStep q hq n) := by
        rw [Subfield.closure_le]
        intro x hx
        exact Subfield.subset_closure (quantumStep_mem_laurent q hq n hx)
      intro a
      rw [ih] at hle
      exact hle (Subfield.mem_top a)
    have hv : quantumGenerator q hq n ∈ F := by
      apply Subfield.subset_closure
      rw [← quantumGenerators_last]
      exact Algebra.subset_adjoin (Or.inl ⟨_, rfl⟩)
    exact skewExtension_subfield_eq_top _ F hstep hv

/-- The units of `T_n` given by the nonzero elements of `𝒜_n`. -/
def quantumLaurentDenominators (n : ℕ) :
    (quantumLaurentSubalgebra q hq n)⁰ →* (QuantumLevel q hq n)ˣ where
  toFun s := Units.mk0 (s : QuantumLevel q hq n) (fun h =>
    nonZeroDivisors.coe_ne_zero s (Subtype.ext h))
  map_one' := by apply Units.ext; rfl
  map_mul' s t := by apply Units.ext; rfl

/-- The canonical map from the Ore localization of `𝒜_n` to `T_n`. -/
def quantumLaurentFractionHom (n : ℕ) :
    OreLocalization (quantumLaurentSubalgebra q hq n)⁰ (quantumLaurentSubalgebra q hq n) →+*
      QuantumLevel q hq n :=
  OreLocalization.universalHom (quantumLaurentSubalgebra q hq n).val.toRingHom
    (quantumLaurentDenominators q hq n) (fun _ => rfl)

theorem quantumLaurentFractionHom_numerator (n : ℕ) (a : quantumLaurentSubalgebra q hq n) :
    quantumLaurentFractionHom q hq n (OreLocalization.numeratorRingHom a) = a :=
  OreLocalization.universalHom_commutes _ _ _

/-- Manuscript `lem:qtorus` (2), last assertion: `T_n` is the division ring of fractions of
`𝒜_n`; the canonical map from the Ore localization of `𝒜_n` is a ring isomorphism extending the
inclusion `𝒜_n ⊆ T_n`. -/
theorem quantumLaurent_fraction_field (n : ℕ) :
    ∃ e : OreLocalization (quantumLaurentSubalgebra q hq n)⁰ (quantumLaurentSubalgebra q hq n) ≃+*
        QuantumLevel q hq n,
      ∀ a : quantumLaurentSubalgebra q hq n, e (OreLocalization.numeratorRingHom a) = a := by
  have hinj : Function.Injective (quantumLaurentFractionHom q hq n) :=
    (quantumLaurentFractionHom q hq n).injective
  have hsurj : Function.Surjective (quantumLaurentFractionHom q hq n) := by
    have hle : Subfield.closure (quantumLaurentSubalgebra q hq n : Set (QuantumLevel q hq n)) ≤
        (quantumLaurentFractionHom q hq n).fieldRange := by
      rw [Subfield.closure_le]
      intro x hx
      exact ⟨OreLocalization.numeratorRingHom ⟨x, hx⟩,
        quantumLaurentFractionHom_numerator q hq n ⟨x, hx⟩⟩
    rw [quantumLaurent_closure] at hle
    intro y
    exact hle (Subfield.mem_top y)
  exact ⟨RingEquiv.ofBijective _ ⟨hinj, hsurj⟩, quantumLaurentFractionHom_numerator q hq n⟩

end
end QuantumFlags
