import QuantumFlags.PureSemisimpleDefs
import QuantumFlags.TriangularRing
import QuantumFlags.IntegerPowerIndependence
import QuantumFlags.PowerIndependence
import QuantumFlags.OreCountable
import Mathlib.RingTheory.Finiteness.Cardinality
import Mathlib.LinearAlgebra.Basis.VectorSpace

/-!
# The triangular ring is not left pure semisimple

Manuscript `thm:main`, last paragraph of the proof (source lines 417-421): the ring
`R = (H T; 0 T)` is not left pure semisimple.  The manuscript deduces this from the failure of the
descending chain condition on left ideals and the theorem of Chase.  Here the conclusion is proved
directly, without the theorem of Chase, by an explicit left `R`-module that is not a direct sum of
finitely generated modules.

Let `D` be a countable division ring and `H ⊆ D` a division subring such that `D` contains an
infinite left `H`-independent family.  Put `D^* = Hom_H(D, H)`.  The left `R`-module
`E = H × D^*` with
`(h a; 0 b) · (u, f) = (h u + f(a), f(· b))`
corresponds to the representation `(H, D^*, ev)` of left modules.

* `D^*` is uncountable: functionals can take arbitrary values `0, 1` on an infinite independent
  family.  Hence `E` is uncountable, while finitely generated modules over the countable ring `R`
  are countable.
* In a decomposition of `E` into a direct sum, the source space `H` of `E` is one-dimensional and
  generated by `(1, 0)`.  Every summand outside the finite support of the image of `(1, 0)` has
  zero source part, and a submodule of `E` with zero source part is zero, because
  `(0 a; 0 0) · (0, f) = (f(a), 0)`.  So the decomposition has only finitely many nonzero summands,
  and a finite direct sum of finitely generated modules is countable.
-/

namespace QuantumFlags
noncomputable section
open DirectSum
universe u w

section Witness

variable {D : Type u} [DivisionRing D] (H : Subfield D)

theorem triangular_lower (r : TriangularRing H) : r.1 1 0 = 0 := r.2.1

theorem triangular_corner_mem (r : TriangularRing H) : r.1 0 0 ∈ H := r.2.2

/-- Right multiplication by `b`, as a left `H`-linear map. -/
def rightMulH (b : D) : D →ₗ[H] D where
  toFun x := x * b
  map_add' x y := add_mul x y b
  map_smul' h x := mul_assoc (h : D) x b

theorem rightMulH_apply (b x : D) : rightMulH H b x = x * b := rfl

/-- The underlying group of the witness module `(H, Hom_H(D, H), ev)`. -/
abbrev WitnessModule := H × (D →ₗ[H] H)

/-- The corner entry of an element of the triangular ring, as an element of `H`. -/
def triangularCorner (r : TriangularRing H) : H := ⟨r.1 0 0, triangular_corner_mem H r⟩

instance witnessSMul : SMul (TriangularRing H) (WitnessModule H) where
  smul r z := (triangularCorner H r * z.1 + z.2 (r.1 0 1), z.2.comp (rightMulH H (r.1 1 1)))

theorem witness_smul_fst (r : TriangularRing H) (z : WitnessModule H) :
    (r • z).1 = triangularCorner H r * z.1 + z.2 (r.1 0 1) := rfl

theorem witness_smul_snd (r : TriangularRing H) (z : WitnessModule H) :
    (r • z).2 = z.2.comp (rightMulH H (r.1 1 1)) := rfl

theorem triangular_mul_entry (r s : TriangularRing H) (i j : Fin 2) :
    (r * s).1 i j = r.1 i 0 * s.1 0 j + r.1 i 1 * s.1 1 j := by
  change (r.1 * s.1) i j = _
  rw [Matrix.mul_apply, Fin.sum_univ_two]

instance witnessModule : Module (TriangularRing H) (WitnessModule H) where
  one_smul z := by
    apply Prod.ext
    · rw [witness_smul_fst]
      have h1 : triangularCorner H 1 = 1 := Subtype.ext (by simp [triangularCorner])
      have h2 : (1 : TriangularRing H).1 0 1 = 0 := by simp
      rw [h1, h2, one_mul, map_zero, add_zero]
    · rw [witness_smul_snd]
      apply LinearMap.ext
      intro x
      have h3 : (1 : TriangularRing H).1 1 1 = 1 := by simp
      simp [rightMulH_apply, h3]
  mul_smul r s z := by
    have hr := triangular_lower H r
    have hs := triangular_lower H s
    apply Prod.ext
    · simp only [witness_smul_fst, witness_smul_snd, LinearMap.comp_apply, rightMulH_apply]
      have hc : triangularCorner H (r * s) = triangularCorner H r * triangularCorner H s := by
        apply Subtype.ext
        change (r * s).1 0 0 = r.1 0 0 * s.1 0 0
        rw [triangular_mul_entry, hs, mul_zero, add_zero]
      have he : (r * s).1 0 1 = (triangularCorner H r : D) * s.1 0 1 + r.1 0 1 * s.1 1 1 := by
        rw [triangular_mul_entry]; rfl
      rw [hc, he, map_add, mul_add, mul_assoc]
      have hsm : z.2 ((triangularCorner H r : D) * s.1 0 1) =
          triangularCorner H r * z.2 (s.1 0 1) := z.2.map_smul (triangularCorner H r) (s.1 0 1)
      rw [hsm, add_assoc]
    · simp only [witness_smul_snd]
      apply LinearMap.ext
      intro x
      simp only [LinearMap.comp_apply, rightMulH_apply]
      have he : (r * s).1 1 1 = r.1 1 1 * s.1 1 1 := by
        rw [triangular_mul_entry, hr, zero_mul, zero_add]
      rw [he, mul_assoc]
  smul_zero r := by
    apply Prod.ext
    · simp [witness_smul_fst]
    · simp [witness_smul_snd]
  smul_add r z z' := by
    apply Prod.ext
    · simp only [witness_smul_fst, Prod.fst_add, Prod.snd_add, LinearMap.add_apply, mul_add]
      abel
    · simp only [witness_smul_snd, Prod.snd_add, LinearMap.add_comp]
  add_smul r s z := by
    apply Prod.ext
    · simp only [witness_smul_fst, Prod.fst_add]
      have hc : triangularCorner H (r + s) = triangularCorner H r + triangularCorner H s :=
        Subtype.ext rfl
      have he : (r + s).1 0 1 = r.1 0 1 + s.1 0 1 := rfl
      rw [hc, he, map_add, add_mul]
      abel
    · simp only [witness_smul_snd, Prod.snd_add]
      apply LinearMap.ext
      intro x
      simp only [LinearMap.comp_apply, rightMulH_apply, LinearMap.add_apply]
      have he : (r + s).1 1 1 = r.1 1 1 + s.1 1 1 := rfl
      rw [he, mul_add, map_add]
  zero_smul z := by
    apply Prod.ext
    · simp only [witness_smul_fst]
      have hc : triangularCorner H 0 = 0 := Subtype.ext rfl
      have he : (0 : TriangularRing H).1 0 1 = 0 := rfl
      rw [hc, he, zero_mul, map_zero, add_zero]
      rfl
    · simp only [witness_smul_snd]
      apply LinearMap.ext
      intro x
      have he : (0 : TriangularRing H).1 1 1 = 0 := rfl
      simp [rightMulH_apply, he]

/-- The idempotent `diag(1,0)`. -/
def sourceIdempotent : TriangularRing H :=
  ⟨!![1,0;0,0], by
    change (!![1,0;0,0] : Matrix (Fin 2) (Fin 2) D) 1 0 = 0 ∧
      (!![1,0;0,0] : Matrix (Fin 2) (Fin 2) D) 0 0 ∈ H
    simpa using H.one_mem⟩

/-- The diagonal element `diag(h,0)`. -/
def sourceScalar (h : H) : TriangularRing H :=
  ⟨!![(h : D),0;0,0], by
    change (!![(h : D),0;0,0] : Matrix (Fin 2) (Fin 2) D) 1 0 = 0 ∧
      (!![(h : D),0;0,0] : Matrix (Fin 2) (Fin 2) D) 0 0 ∈ H
    simpa using h.property⟩

theorem sourceIdempotent_smul (z : WitnessModule H) :
    sourceIdempotent H • z = (z.1, 0) := by
  apply Prod.ext
  · rw [witness_smul_fst]
    have hc : triangularCorner H (sourceIdempotent H) = 1 := Subtype.ext rfl
    have he : (sourceIdempotent H).1 0 1 = 0 := rfl
    rw [hc, he, one_mul, map_zero, add_zero]
  · rw [witness_smul_snd]
    apply LinearMap.ext
    intro x
    have he : (sourceIdempotent H).1 1 1 = 0 := rfl
    simp [rightMulH_apply, he]

theorem sourceScalar_smul_generator (h : H) :
    sourceScalar H h • ((1, 0) : WitnessModule H) = (h, 0) := by
  apply Prod.ext
  · rw [witness_smul_fst]
    have hc : triangularCorner H (sourceScalar H h) = h := Subtype.ext rfl
    rw [hc, mul_one]
    simp
  · rw [witness_smul_snd]
    simp

theorem offDiagonal_smul (a : D) (z : WitnessModule H) :
    (offDiagonal H a • z).1 = triangularCorner H (offDiagonal H a) * z.1 + z.2 a := rfl

theorem offDiagonal_corner (a : D) : triangularCorner H (offDiagonal H a) = 0 :=
  Subtype.ext rfl

/-- The source part of `E` is generated by `(1, 0)`. -/
theorem sourceIdempotent_smul_eq (z : WitnessModule H) :
    sourceIdempotent H • z = sourceScalar H z.1 • ((1, 0) : WitnessModule H) := by
  rw [sourceIdempotent_smul, sourceScalar_smul_generator]

/-- The dual `Hom_H(D, H)` is uncountable when `D` has an infinite left independent family. -/
theorem leftDual_not_countable {v : ℕ → D} (hv : LinearIndependent H v) :
    ¬ Countable (D →ₗ[H] H) := by
  classical
  intro hc
  let P := Submodule.span H (Set.range v)
  let b : Module.Basis ℕ H P := Module.Basis.span hv
  have hext : ∀ s : Set ℕ, ∃ g : D →ₗ[H] H, ∀ i, g (v i) = if i ∈ s then 1 else 0 := by
    intro s
    obtain ⟨g, hg⟩ := LinearMap.exists_extend
      (b.constr ℕ (fun i => if i ∈ s then (1 : H) else 0))
    refine ⟨g, fun i => ?_⟩
    have h1 : (b i : D) = v i := congrArg Subtype.val (Module.Basis.span_apply hv i)
    have := congrArg (fun φ => φ (b i)) hg
    simp only [LinearMap.comp_apply, Submodule.subtype_apply, h1, Module.Basis.constr_basis] at this
    exact this
  choose g hg using hext
  have hinj : Function.Injective g := by
    intro s s' hss
    ext i
    have h := congrArg (fun φ => φ (v i)) hss
    simp only [hg] at h
    by_cases hi : i ∈ s <;> by_cases hi' : i ∈ s' <;> simp_all
  haveI : Countable (Set ℕ) := hinj.countable
  obtain ⟨f, hf⟩ := exists_surjective_nat (Set ℕ)
  exact Function.cantor_surjective f hf

theorem witnessModule_not_countable {v : ℕ → D} (hv : LinearIndependent H v) :
    ¬ Countable (WitnessModule H) := by
  intro hc
  apply leftDual_not_countable H hv
  exact (show Function.Surjective (Prod.snd : WitnessModule H → (D →ₗ[H] H)) from
    fun f => ⟨(0, f), rfl⟩).countable

/-- A finitely generated module over a countable ring is countable. -/
theorem countable_of_module_finite {R M : Type*} [Ring R] [Countable R] [AddCommGroup M]
    [Module R M] [Module.Finite R M] : Countable M := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  exact hf.countable

instance triangularRing_countable [Countable D] : Countable (TriangularRing H) := by
  haveI : Countable (Matrix (Fin 2) (Fin 2) D) := inferInstanceAs (Countable (Fin 2 → Fin 2 → D))
  exact Subtype.countable

/-- In any decomposition of `E` into a direct sum of finitely generated modules, `E` is
countable. -/
theorem witnessModule_countable_of_decomposition [Countable D] {κ : Type*} (Y : κ → Type*)
    [∀ k, AddCommGroup (Y k)] [∀ k, Module (TriangularRing H) (Y k)]
    (hfin : ∀ k, Module.Finite (TriangularRing H) (Y k))
    (φ : WitnessModule H ≃ₗ[TriangularRing H] ⨁ k, Y k) : Countable (WitnessModule H) := by
  classical
  let F := (φ ((1, 0) : WitnessModule H)).support
  -- An element of the direct sum vanishing on `F` comes from an element of `E` with zero
  -- source part.
  have hsource : ∀ w : ⨁ k, Y k, (∀ k ∈ F, w k = 0) → (φ.symm w).1 = 0 := by
    intro w hw
    have he : sourceIdempotent H • w = 0 := by
      ext k
      by_cases hk : k ∈ F
      · change sourceIdempotent H • w k = 0
        rw [hw k hk, smul_zero]
      · have h1 : sourceIdempotent H • w = φ (sourceIdempotent H • φ.symm w) := by
          rw [map_smul, LinearEquiv.apply_symm_apply]
        rw [h1, sourceIdempotent_smul_eq, map_smul]
        change sourceScalar H (φ.symm w).1 • (φ ((1, 0) : WitnessModule H)) k = 0
        rw [DFinsupp.notMem_support_iff.mp hk, smul_zero]
    have h2 : φ (sourceIdempotent H • φ.symm w) = 0 := by
      rw [map_smul, LinearEquiv.apply_symm_apply, he]
    have h3 := φ.injective (h2.trans (map_zero φ).symm)
    rw [sourceIdempotent_smul] at h3
    exact congrArg Prod.fst h3
  -- Hence such an element is zero.
  have hzero : ∀ w : ⨁ k, Y k, (∀ k ∈ F, w k = 0) → w = 0 := by
    intro w hw
    have h1 := hsource w hw
    have h2 : ∀ a : D, (φ.symm w).2 a = 0 := by
      intro a
      have hwa : ∀ k ∈ F, (offDiagonal H a • w) k = 0 := by
        intro k hk
        change offDiagonal H a • w k = 0
        rw [hw k hk, smul_zero]
      have h := hsource _ hwa
      rw [map_smul, offDiagonal_smul, offDiagonal_corner, h1, zero_mul, zero_add] at h
      exact h
    have h3 : φ.symm w = 0 := Prod.ext h1 (LinearMap.ext h2)
    simpa using congrArg φ h3
  -- Every element of the direct sum is supported on `F`.
  haveI : ∀ k, Countable (Y k) := fun k => countable_of_module_finite (R := TriangularRing H)
  have hsurj : Function.Surjective (fun c : (k : F) → Y k.1 =>
      ∑ k : F, DirectSum.of Y k.1 (c k)) := by
    intro w
    refine ⟨fun k => w k.1, ?_⟩
    have hdiff := hzero (w - ∑ k : F, DirectSum.of Y k.1 (w k.1)) (by
      intro k hk
      rw [DFinsupp.sub_apply, DFinsupp.finsetSum_apply]
      rw [Finset.sum_eq_single ⟨k, hk⟩]
      · rw [DirectSum.of_eq_same, sub_self]
      · intro c _ hne
        exact DirectSum.of_eq_of_ne _ _ _ (fun he => hne (Subtype.ext he.symm))
      · intro h; exact absurd (Finset.mem_univ _) h)
    exact (sub_eq_zero.mp hdiff).symm
  haveI : Countable (⨁ k, Y k) := hsurj.countable
  exact Function.Injective.countable φ.injective

/-- If `D` is countable and contains an infinite left `H`-independent family, then the
triangular ring `(H D; 0 D)` is not left pure semisimple. -/
theorem triangular_not_left_pure_semisimple [Countable D] {v : ℕ → D}
    (hv : LinearIndependent H v) : ¬ IsLeftPureSemisimple.{u, max u w} (TriangularRing H) := by
  intro h
  obtain ⟨κ, Y, _, _, hfin, ⟨ψ⟩⟩ := h (ULift.{w} (WitnessModule H))
  let φ : WitnessModule H ≃ₗ[TriangularRing H] ⨁ k, Y k :=
    (ULift.moduleEquiv (R := TriangularRing H) (M := WitnessModule H)).symm.trans ψ
  exact witnessModule_not_countable H hv (witnessModule_countable_of_decomposition H Y hfin φ)

end Witness

/-- Manuscript `thm:main`: the actual ring `R = (H T; 0 T)` is not left pure semisimple. -/
theorem actual_triangular_not_left_pure_semisimple :
    ¬ IsLeftPureSemisimple.{0, w} (TriangularRing (actualFlagSystem.H 1)) := by
  have hv : LinearIndependent (actualFlagSystem.H 1) (fun i : ℕ => actualFlagSystem.t ^ i) :=
    linearIndependent_nat_of_prefix (fun i : ℕ => actualFlagSystem.t ^ i)
      (fun e => left_powers_linearIndependent actualFlagSystem 1 le_rfl e)
  exact triangular_not_left_pure_semisimple.{0,w} (actualFlagSystem.H 1) hv

end
end QuantumFlags
